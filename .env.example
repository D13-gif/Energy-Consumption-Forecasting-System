# Flask Configuration
FLASK_CONFIG=development
SECRET_KEY=your-secret-key-change-in-production

# Server
PORT=5000

# Database (SQLite - file based)
# Set these paths to a persistent volume when running the full app on a host.
# SQLITE_DB_PATH=/var/data/instance/energicast.sqlite
# INSTANCE_DIR=/var/data/instance

# Data Paths
# DATA_DIR=/var/data/data
# RAW_DATA_DIR=/var/data/data/raw
# PROCESSED_DATA_DIR=/var/data/data/processed
# ARTIFACTS_DIR=/var/data/artifacts
# MODELS_DIR=/var/data/artifacts/models
# SCALERS_DIR=/var/data/artifacts/scalers
# PLOTS_DIR=/var/data/artifacts/plots
# METADATA_DIR=/var/data/artifacts/metadata

# Dataset
# DATASET_FILENAME=household_power_consumption.txt

# Model Defaults
# DEFAULT_WINDOW_SIZE=24
# DEFAULT_LSTM_UNITS=32
# DEFAULT_EPOCHS=20
# DEFAULT_BATCH_SIZE=32
# DEFAULT_LEARNING_RATE=0.001
# DEFAULT_DROPOUT=0.1
# DEFAULT_TRAIN_RATIO=0.7
# DEFAULT_VAL_RATIO=0.15
# DEFAULT_TEST_RATIO=0.15